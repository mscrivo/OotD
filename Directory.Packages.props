<Project>

  <!--
    Central Package Management for the OotD application projects only.

    It is disabled for the MACTrackBarLib / NetSparkle submodules because they
    pin their own package versions directly on their PackageReference items,
    which is incompatible with central management (NU1008).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally Condition="$(MSBuildProjectName.StartsWith('OotD'))">true</ManagePackageVersionsCentrally>
    <ManagePackageVersionsCentrally Condition="!$(MSBuildProjectName.StartsWith('OotD'))">false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('OotD'))">
    <!-- Application -->
    <PackageVersion Include="CommandLineParser" Version="2.9.1" />
    <PackageVersion Include="NLog" Version="6.1.4" />
    <PackageVersion Include="NLog.Schema" Version="6.1.4" />
    <PackageVersion Include="TaskScheduler" Version="2.12.2" />

    <!-- Test (Microsoft.Testing.Platform) -->
    <PackageVersion Include="coverlet.MTP" Version="10.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" />
    <PackageVersion Include="AwesomeAssertions" Version="9.5.0" />
  </ItemGroup>

</Project>
